{
  "id": "codexusage",
  "name": "CodexUsage",
  "version": "0.2.0",
  "minNoctaliaVersion": "4.6.6",
  "author": "RinStel",
  "license": "GLWT",
  "repository": "https://github.com/RinStel/CodexUsage-noctalia-plugin",
  "description": "Desktop widget for Codex quota, token usage, API-equivalent value, and today's task board.",
  "tags": ["Desktop", "Developer Tools", "Codex"],
  "entryPoints": {
    "desktopWidget": "DesktopWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "refreshIntervalSeconds": 120,
      "codexHome": "",
      "backgroundOpacity": 0.78,
      "cardOpacity": 0.56,
      "showTaskBoard": true,
      "showMessages": true,
      "taskWindowDays": 1,
      "themeMode": "system",
      "language": "zh"
    }
  }
}
